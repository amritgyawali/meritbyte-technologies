# /free-website sign-up. Set these in Vercel: Project > Settings > Environment Variables.

# Resend API key for meritbyte.com (sends the confirmation email and the owner notice).
RESEND_API_KEY=

# Any random string of 24+ characters. Signs the confirmation links.
SIGNUP_SECRET=

# Optional. Confirmed sign-ups are added to this Brevo list.
# Run `BREVO_API_KEY=... node scripts/brevo-setup.mjs` once to create it and get the id.
BREVO_API_KEY=
BREVO_LIST_ID=

# Who is told about each confirmed sign-up (comma-separated).
OWNER_EMAIL=amritgyawali999@gmail.com

# Site address used in canonical URLs, the sitemap, structured data and llms.txt.
# Defaults to https://meritbyte.com. Set it if the live site is on www or another domain.
NEXT_PUBLIC_SITE_URL=

# Search engine ownership verification (the content value of the meta tag they give you).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
