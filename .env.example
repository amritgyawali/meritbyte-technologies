# Set these in Vercel: Project > Settings > Environment Variables.
# For local runs and the npm scripts, copy to .env.local.

# Supabase: public.subscribers is the source of truth for every sign-up.
# Service role key is server-only; never expose it to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Brevo copies each subscriber from Supabase and sends the newsletters.
# `npm run brevo:setup` creates both lists and prints their ids.
BREVO_API_KEY=
BREVO_LIST_ID=
BREVO_SUBSCRIBE_LIST_ID=
# Random string of 24+ characters; goes in the Brevo webhook URL as ?key=
BREVO_WEBHOOK_SECRET=

# Vercel sends this to the daily /api/cron/brevo-sync. Random, 24+ characters.
CRON_SECRET=

# Who sends the confirmation and owner emails: resend (default) or brevo.
# Switch to brevo only once meritbyte.com is authenticated in Brevo.
MAIL_PROVIDER=resend
RESEND_API_KEY=

# Any random string of 24+ characters. Signs the confirmation links.
SIGNUP_SECRET=

# Who is told about each confirmed sign-up (comma-separated).
OWNER_EMAIL=amritgyawali999@gmail.com
